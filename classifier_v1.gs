/**
 * Google Apps Script: Wrong-Person Classifier + Alternate Email Extractor
 *
 * Reads:
 * - Column O (email_body_text)
 * - Column P (email_body_html)
 *
 * Optionally excludes the original email if it can find a column header named:
 * - original_email OR email OR to_email OR recipient_email
 *
 * Writes output starting at Column Q:
 * Q: reply_type
 * R: tag
 * S: subtype
 * T: total_score
 * U: best_alternate_email
 * V: best_alternate_name
 * W: alternate_emails (comma-separated)
 * X: matched_patterns (JSON)
 *
 * How to use:
 * 1) Extensions -> Apps Script
 * 2) Paste this code
 * 3) Run: classifyWrongPersonReplies()
 */

function classifyWrongPersonReplies() {
  const sheet = SpreadsheetApp.getActiveSheet();
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();
  if (lastRow < 2) return;

  const header = sheet.getRange(1, 1, 1, lastCol).getValues()[0].map(v => String(v || "").trim());
  const headerLower = header.map(h => h.toLowerCase());

  // Fixed columns per your instruction: O and P
  const COL_EMAIL_BODY_TEXT = 15; // O
  const COL_EMAIL_BODY_HTML = 16; // P

  // Optional original email column by header
  const originalEmailCol = findFirstHeaderIndex_(headerLower, ["lead_email", "email", "to_email", "recipient_email"]);
  const originalEmailCol1Based = originalEmailCol >= 0 ? originalEmailCol + 1 : null;

  const numRows = lastRow - 1;
  const range = sheet.getRange(2, 1, numRows, lastCol);
  const values = range.getValues();

  // Prepare output columns Q..X (8 columns)
  const output = new Array(numRows);
  for (let i = 0; i < numRows; i++) {
    const row = values[i];

    const bodyText = safeString_(row[COL_EMAIL_BODY_TEXT - 1]);
    const bodyHtml = safeString_(row[COL_EMAIL_BODY_HTML - 1]);

    const originalEmail = originalEmailCol1Based ? safeString_(row[originalEmailCol1Based - 1]).trim() : "";

    const replyText = chooseReplyText_(bodyText, bodyHtml);
    const result = classifyReply_(replyText, originalEmail);

    output[i] = [
      result.reply_type,
      result.tag,
      result.subtype || "",
      result.total_score,
      result.best_alternate_email || "",
      result.best_alternate_name || "",
      (result.alternate_emails || []).join(", "),
      JSON.stringify(result.matched_patterns || {})
    ];
  }

  // Write headers if missing in Q1..X1
  const outHeaderRange = sheet.getRange(1, 17, 1, 8); // Q..X
  const existingOutHeader = outHeaderRange.getValues()[0].map(v => String(v || "").trim().toLowerCase());
  const desiredOutHeader = [
    "reply_type",
    "tag",
    "subtype",
    "total_score",
    "best_alternate_email",
    "best_alternate_name",
    "alternate_emails",
    "matched_patterns"
  ];

  let shouldWriteHeaders = false;
  for (let j = 0; j < desiredOutHeader.length; j++) {
    if (existingOutHeader[j] !== desiredOutHeader[j]) {
      shouldWriteHeaders = true;
      break;
    }
  }
  if (shouldWriteHeaders) {
    outHeaderRange.setValues([desiredOutHeader]);
  }

  // Write output
  sheet.getRange(2, 17, numRows, 8).setValues(output);
}

/* ---------------------------
 * Core classifier (rules-based)
 * ---------------------------
 */

const THRESHOLD_MAX_BUCKET_ = 6;
const OOO_PENALTY_ = 8;

const SUBTYPE_PRIORITY_ = [
  "WP6_DECEASED",
  "WP5_COMPANY_CLOSED",
  "WP1_LEFT_COMPANY",
  "WP4_EMAIL_CHANGED_OR_FORWARDING",
  "WP3_NOT_MONITORED",
  "WP2_NOT_RIGHT_PERSON"
];

const DSN_PATTERNS_ = compilePatterns_([
  ["dsn_field_final_recipient", "\\bFinal-Recipient:\\b", 10],
  ["dsn_field_action", "\\bAction:\\b", 10],
  ["dsn_field_status", "\\bStatus:\\b", 10],
  ["dsn_field_diagnostic_code", "\\bDiagnostic-Code:\\b", 10],
  ["dsn_enhanced_status_code", "\\b[245]\\.\\d\\.\\d\\b", 8],
  ["dsn_phrase_delivery_status_notification", "\\bDelivery Status Notification\\b", 8],
  ["dsn_phrase_undeliverable", "\\bUndeliverable\\b", 6],
  ["dsn_phrase_mail_delivery_subsystem", "\\bMail Delivery Subsystem\\b", 6],
  ["dsn_phrase_returned_mail", "\\breturned mail\\b", 6]
], "i");

const AUTO_REPLY_PATTERNS_ = compilePatterns_([
  ["auto_phrase_auto_reply", "\\bauto[- ]?reply\\b", 2],
  ["auto_phrase_automatic_reply", "\\bautomatic reply\\b", 2],
  ["auto_phrase_autoresponse", "\\bauto[- ]?response\\b", 2],
  ["auto_phrase_autogenerated", "\\bauto[- ]generated\\b", 2],
  ["auto_phrase_automated_message", "\\bautomated message\\b", 2],
  ["auto_phrase_do_not_reply", "\\bdo not reply\\b", 2],
  ["auto_phrase_replies_not_monitored", "\\breplies (are|aren't|are not) (reviewed|monitored)\\b", 2]
], "i");

const OOO_PATTERNS_ = compilePatterns_([
  ["ooo_out_of_office", "\\bout of office\\b|\\booo\\b", 1],
  ["ooo_on_vacation", "\\bon vacation\\b|\\bholiday\\b", 1],
  ["ooo_away", "\\baway from (the )?office\\b|\\bcurrently away\\b", 1],
  ["ooo_return_on", "\\b(back|return(ing)?) (on|by)\\b", 1],
  ["ooo_limited_access", "\\blimited access\\b|\\bno access to email\\b", 1]
], "i");

const WP_PATTERNS_ = {
  "WP1_LEFT_COMPANY": compilePatterns_([
    ["wp1_no_longer_with_company", "\\bno longer with (the )?(company|organization|firm|team)\\b", 5],
    ["wp1_no_longer_working", "\\bno longer (work|working|employed)\\b.*\\b(at|with|for)\\b", 5],
    ["wp1_has_left", "\\b(has|have) left (the )?(company|organization|firm)\\b", 5],
    ["wp1_not_employed", "\\bis no longer employed\\b", 5],
    ["wp1_former_employee", "\\bformer employee\\b", 5],
    ["wp1_moved_on", "\\b(moved on|move on) from\\b", 5],
    ["wp1_doesnt_work_here", "\\bdoes(n't| not) work (here|there) anymore\\b", 5]
  ], "i"),

  "WP2_NOT_RIGHT_PERSON": compilePatterns_([
    ["wp2_not_right_person", "\\b(i am|i'm) not the right person\\b", 4],
    ["wp2_not_correct_person", "\\bnot the (correct|right) person\\b", 4],
    ["wp2_not_my_area", "\\bnot my area\\b|\\bnot my department\\b", 4],
    ["wp2_i_dont_handle", "\\b(i do not|i don't) handle\\b", 4],
    ["wp2_wrong_contact", "\\bwrong contact\\b|\\bwrong person\\b", 4],
    ["wp2_you_should_talk_to", "\\byou should (talk|speak|reach out) to\\b", 4],
    ["wp2_best_person_is", "\\bbest person (to|for this) is\\b", 4]
  ], "i"),

  "WP3_NOT_MONITORED": compilePatterns_([
    ["wp3_mailbox_not_monitored", "\\b(mailbox|inbox|email address) (is|is now|is no longer) (not )?monitored\\b", 5],
    ["wp3_inbox_not_monitored", "\\b(this )?inbox (is|is no longer) (not )?monitored\\b", 5],
    ["wp3_replies_not_reviewed", "\\breplies to this email (are|aren't|are not) (reviewed|monitored)\\b", 5],
    ["wp3_do_not_reply", "\\bdo not reply to this email\\b", 5],
    ["wp3_unattended", "\\b(mailbox|inbox) is unattended\\b", 5]
  ], "i"),

  "WP4_EMAIL_CHANGED_OR_FORWARDING": compilePatterns_([
    ["wp4_update_contacts", "\\bplease update your contacts\\b", 5],
    ["wp4_new_email_address_is", "\\b(my )?new email address is\\b", 5],
    ["wp4_use_following_email", "\\buse (this|the following) email address\\b", 5],
    ["wp4_address_deactivated", "\\b(this|the) (address|email) (will be|is being) (deactivated|disabled|retired|closed)\\b", 5],
    ["wp4_no_longer_in_use", "\\b(this|the) email address (will )?no longer be in use\\b|\\b(this|the) address is no longer in use\\b", 5],
    ["wp4_forwarding_redirecting", "\\b(messages|emails) (are|will be) (being )?(forwarded|redirected)\\b", 5],
    ["wp4_forwarded_to_new_account", "\\bforwarded on to my new email (account|address)\\b", 5],
    ["wp4_end_of_year_no_longer_in_use", "\\bno longer in use by the end of the year\\b", 5]
  ], "i"),

  "WP5_COMPANY_CLOSED": compilePatterns_([
    ["wp5_we_have_closed", "\\bwe have closed\\b", 6],
    ["wp5_closed_permanently", "\\bclosed permanently\\b", 6],
    ["wp5_ceased_operations", "\\bceased operations\\b", 6],
    ["wp5_no_longer_operating", "\\bno longer operating\\b", 6],
    ["wp5_out_of_business", "\\bout of business\\b", 6],
    ["wp5_shut_down", "\\b(company|business) (has )?shut down\\b", 6],
    ["wp5_no_longer_in_business", "\\bno longer in business\\b", 6]
  ], "i"),

  "WP6_DECEASED": compilePatterns_([
    ["wp6_passed_away", "\\bhas passed away\\b|\\bpassed away on\\b", 8],
    ["wp6_saddened_to_inform", "\\b(saddened|sorry) to inform you\\b", 8],
    ["wp6_is_deceased", "\\bis deceased\\b", 8],
    ["wp6_in_memoriam", "\\bin memoriam\\b", 8]
  ], "i")
};

function classifyReply_(replyText, originalEmail) {
  const textRaw = preprocessRaw_(replyText);
  const textNorm = normalize_(textRaw);

  const allEmails = extractEmails_(textRaw);
  const alternateEmails = filterAlternateEmails_(allEmails, originalEmail);

  // Step A: DSN detection
  const dsn = matchScore_(textNorm, DSN_PATTERNS_);
  if (dsn.score >= 10) {
    const bestAlt = rankBestAlternateEmail_(textNorm, originalEmail, alternateEmails);
    return {
      reply_type: "dsn_bounce",
      tag: "dsn_bounce",
      subtype: null,
      total_score: dsn.score,
      bucket_scores: {},
      matched_patterns: { DSN: dsn.matched },
      alternate_emails: alternateEmails,
      best_alternate_email: bestAlt,
      best_alternate_name: bestAlt ? extractNameNearEmail_(textRaw, bestAlt) : null
    };
  }

  // Step B: auto reply vs human reply
  const auto = matchScore_(textNorm, AUTO_REPLY_PATTERNS_);
  const replyType = auto.score > 0 ? "auto_reply" : "human_reply";

  // Step C: wrong person scoring per subtype
  const bucketScores = {};
  const matchedPatterns = {};
  let totalScore = 0;

  Object.keys(WP_PATTERNS_).forEach(subtype => {
    const res = matchScore_(textNorm, WP_PATTERNS_[subtype]);
    bucketScores[subtype] = res.score;
    totalScore += res.score;
    if (res.matched.length) matchedPatterns[subtype] = res.matched;
  });

  // OOO penalty
  const ooo = matchScore_(textNorm, OOO_PATTERNS_);
  if (ooo.matched.length) matchedPatterns["OOO"] = ooo.matched;

  const maxBucket = maxValue_(bucketScores);
  if (ooo.score > 0 && maxBucket < THRESHOLD_MAX_BUCKET_) {
    totalScore -= OOO_PENALTY_;
  }

  if (maxBucket >= THRESHOLD_MAX_BUCKET_) {
    const bestSubtypes = Object.keys(bucketScores).filter(k => bucketScores[k] === maxBucket);
    let chosen = null;
    for (let i = 0; i < SUBTYPE_PRIORITY_.length; i++) {
      if (bestSubtypes.indexOf(SUBTYPE_PRIORITY_[i]) >= 0) {
        chosen = SUBTYPE_PRIORITY_[i];
        break;
      }
    }
    if (!chosen) chosen = bestSubtypes[0];

    const bestAlt = rankBestAlternateEmail_(textNorm, originalEmail, alternateEmails);
    return {
      reply_type: replyType,
      tag: "wrong_person",
      subtype: chosen,
      total_score: totalScore,
      bucket_scores: bucketScores,
      matched_patterns: matchedPatterns,
      alternate_emails: alternateEmails,
      best_alternate_email: bestAlt,
      best_alternate_name: bestAlt ? extractNameNearEmail_(textRaw, bestAlt) : null
    };
  }

  const bestAlt = rankBestAlternateEmail_(textNorm, originalEmail, alternateEmails);
  return {
    reply_type: replyType,
    tag: "not_wrong_person",
    subtype: null,
    total_score: totalScore,
    bucket_scores: bucketScores,
    matched_patterns: matchedPatterns,
    alternate_emails: alternateEmails,
    best_alternate_email: bestAlt,
    best_alternate_name: bestAlt ? extractNameNearEmail_(textRaw, bestAlt) : null
  };
}

/* ---------------------------
 * Preprocessing
 * ---------------------------
 */

function chooseReplyText_(bodyText, bodyHtml) {
  const t = (bodyText || "").trim();
  if (t) return t;
  const h = (bodyHtml || "").trim();
  return h ? h : "";
}

function preprocessRaw_(input) {
  let text = safeString_(input);
  text = stripHtml_(text);
  text = stripQuotedThread_(text);
  return text.trim();
}

function stripHtml_(text) {
  // If there are obvious tags, strip. If not, return as-is.
  const hasTag = /<[^>]+>/.test(text);
  if (!hasTag) return text;

  let t = text;
  t = t.replace(/<\s*(script|style)[^>]*>[\s\S]*?<\s*\/\s*\1\s*>/gi, " ");
  t = t.replace(/<br\s*\/?>/gi, "\n");
  t = t.replace(/<\/p\s*>/gi, "\n");
  t = t.replace(/<[^>]+>/g, " ");
  t = decodeEntities_(t);
  return t;
}

function decodeEntities_(text) {
  // Minimal entity decode
  return text
    .replace(/&nbsp;/gi, " ")
    .replace(/&amp;/gi, "&")
    .replace(/&lt;/gi, "<")
    .replace(/&gt;/gi, ">")
    .replace(/&quot;/gi, "\"")
    .replace(/&#39;/gi, "'");
}

function stripQuotedThread_(text) {
  const lines = text.split(/\r?\n/);
  const kept = [];
  for (let i = 0; i < lines.length; i++) {
    const ln = lines[i];
    if (ln.trim().startsWith(">")) continue;
    kept.push(ln);
  }
  const text2 = kept.join("\n");

  const lower = text2.toLowerCase();

  const separators = [
    "-----original message-----",
    "----- original message -----"
  ];

  let cutIndex = -1;
  separators.forEach(sep => {
    const idx = lower.indexOf(sep);
    if (idx >= 0) cutIndex = cutIndex === -1 ? idx : Math.min(cutIndex, idx);
  });

  // "On <date>, <name> wrote:"
  const m = text2.match(/^\s*on .+ wrote:\s*$/im);
  if (m && m.index !== undefined) {
    cutIndex = cutIndex === -1 ? m.index : Math.min(cutIndex, m.index);
  }

  if (cutIndex >= 0) return text2.slice(0, cutIndex).trim();
  return text2.trim();
}

function normalize_(text) {
  return safeString_(text).replace(/\s+/g, " ").trim().toLowerCase();
}

/* ---------------------------
 * Matching utilities
 * ---------------------------
 */

function compilePatterns_(items, flags) {
  return items.map(it => {
    return { id: it[0], re: new RegExp(it[1], flags), weight: it[2] };
  });
}

function matchScore_(textNorm, patterns) {
  let score = 0;
  const matched = [];
  for (let i = 0; i < patterns.length; i++) {
    const p = patterns[i];
    if (p.re.test(textNorm)) {
      score += p.weight;
      matched.push(p.id);
    }
  }
  return { score, matched };
}

function maxValue_(obj) {
  let m = 0;
  Object.keys(obj).forEach(k => {
    if (obj[k] > m) m = obj[k];
  });
  return m;
}

/* ---------------------------
 * Email extraction + ranking
 * ---------------------------
 */

function extractEmails_(textRaw) {
  const found = {};
  const t = safeString_(textRaw);

  // Standard emails
  const re1 = /([a-z0-9._%+-]+)@([a-z0-9.-]+\.[a-z]{2,})/gi;
  let m;
  while ((m = re1.exec(t)) !== null) {
    const email = (m[1] + "@" + m[2]).toLowerCase();
    found[email] = true;
  }

  // Obfuscated: name (at) domain (dot) com (dot) uk
  const re2 = /([a-z0-9._%+-]+)\s*(?:\(|\[)?\s*(?:at|@)\s*(?:\)|\])?\s*([a-z0-9.-]+)\s*(?:\(|\[)?\s*(?:dot|\.)\s*(?:\)|\])?\s*([a-z]{2,})(?:\s*(?:\(|\[)?\s*(?:dot|\.)\s*(?:\)|\])?\s*([a-z]{2,}))?/gi;
  while ((m = re2.exec(t)) !== null) {
    const local = (m[1] || "").toLowerCase();
    const domain = (m[2] || "").toLowerCase();
    const tld1 = (m[3] || "").toLowerCase();
    const tld2 = (m[4] || "").toLowerCase();
    if (local && domain && tld1) {
      const email = tld2 ? (local + "@" + domain + "." + tld1 + "." + tld2) : (local + "@" + domain + "." + tld1);
      found[email] = true;
    }
  }

  return Object.keys(found).sort();
}

function filterAlternateEmails_(emails, originalEmail) {
  const original = safeString_(originalEmail).trim().toLowerCase();
  const out = [];
  for (let i = 0; i < emails.length; i++) {
    const e = emails[i];
    if (!e) continue;
    if (original && e === original) continue;

    const local = e.split("@")[0] || "";
    if (/^(no[-_]?reply|do[-_]?not[-_]?reply|donotreply|mailer-daemon|postmaster)$/i.test(local)) continue;

    out.push(e);
  }
  return out;
}

function rankBestAlternateEmail_(textNorm, originalEmail, candidates) {
  if (!candidates || !candidates.length) return null;

  let origDomain = "";
  const o = safeString_(originalEmail).toLowerCase();
  if (o.indexOf("@") >= 0) origDomain = o.split("@")[1];

  const cue = /\b(contact|reach|email|write to|forward|redirected|new email)\b/i;

  let best = null;
  let bestScore = -999;

  for (let i = 0; i < candidates.length; i++) {
    const e = candidates[i];
    let score = 0;

    const idx = textNorm.indexOf(e);
    if (idx >= 0) {
      const left = Math.max(0, idx - 120);
      const right = Math.min(textNorm.length, idx + 120);
      const window = textNorm.slice(left, right);
      if (cue.test(window)) score += 3;

      // extra signal: "new email ... <email>"
      const rx = new RegExp("\\bnew email\\b[\\s\\S]{0,80}" + escapeRegex_(e), "i");
      if (rx.test(window)) score += 1;
    }

    if (origDomain && e.endsWith("@" + origDomain)) score += 2;

    if (score > bestScore) {
      bestScore = score;
      best = e;
    }
  }

  return bestScore >= 3 ? best : null;
}

function extractNameNearEmail_(textRaw, bestEmail) {
  if (!bestEmail) return null;
  const raw = safeString_(textRaw);
  const idx = raw.toLowerCase().indexOf(bestEmail.toLowerCase());
  if (idx < 0) return null;

  const start = Math.max(0, idx - 140);
  const end = Math.min(raw.length, idx + 40);
  const window = raw.slice(start, end);

  // Contact John Smith at john@x.com
  let m = window.match(new RegExp("\\bcontact\\s+([A-Z][a-z]+(?:\\s+[A-Z][a-z]+){0,2})\\s+(?:at|via)\\s+" + escapeRegex_(bestEmail), "i"));
  if (m && m[1]) return m[1].trim();

  // John Smith (john@x.com)
  m = window.match(new RegExp("([A-Z][a-z]+(?:\\s+[A-Z][a-z]+){0,2})\\s*\\(\\s*" + escapeRegex_(bestEmail) + "\\s*\\)", "i"));
  if (m && m[1]) return m[1].trim();

  // John Smith: john@x.com  OR John Smith - john@x.com
  m = window.match(new RegExp("([A-Z][a-z]+(?:\\s+[A-Z][a-z]+){0,2})\\s*[:\\-]\\s*" + escapeRegex_(bestEmail), "i"));
  if (m && m[1]) return m[1].trim();

  return null;
}

/* ---------------------------
 * Misc utilities
 * ---------------------------
 */

function safeString_(v) {
  if (v === null || v === undefined) return "";
  return String(v);
}

function escapeRegex_(s) {
  return String(s).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function findFirstHeaderIndex_(headerLower, candidates) {
  for (let i = 0; i < candidates.length; i++) {
    const idx = headerLower.indexOf(candidates[i]);
    if (idx >= 0) return idx;
  }
  return -1;
}
